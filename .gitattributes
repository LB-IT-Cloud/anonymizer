* text=auto

# The offline file is checked by its SHA-256, and a fingerprint is a promise about bytes: LF in
# every working tree, Windows included, so the file on disk is the file that was fingerprinted.
anonymizer-offline.html text eol=lf
*.sha256 text eol=lf

*.docx binary
*.pptx binary
*.xlsx binary
